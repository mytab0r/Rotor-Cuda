{
  "name": "nav",
  "version": "0.1.0",
  "status": "stable",
  "element": "header",
  "variants": [
    {
      "id": "site",
      "label": "Site navigation shell",
      "classes": ["site-nav"],
      "external": "page-header"
    }
  ],
  "sizes": [
    {
      "id": "default",
      "label": "Default (min-height 60)",
