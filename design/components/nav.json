    {
      "id": "default",
      "label": "Default"
    }
  ],
  "requiredAttrs": [],
  "forbidden": [
    "A page-local nav pill or one-off icon wrapper.",
    "More than three persistent utility controls (search icon-button, theme icon-button, cabinet chip); the runtime More disclosure is allowed.",
    "A nav link below 44px with an icon other than 18px.",
    "A second row of primary links: move the overflow into the More drawer.",
    "A second navigation toolbar for the same destinations."
  ],
  "slots": [],
