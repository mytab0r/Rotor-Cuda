    "--z-nav",
    "--space-1",
    "--space-2",
    "--space-3",
    "--space-4",
    "--space-5",
    "--maxw",
    "--control-h",
    "--radius-pill",
    "--nav-bg",
    "--nav-border",
    "--ink-1",
    "--ink-2",
    "--text-md",
    "--text-xl",
    "--weight-semibold",
    "--icon-size-lg",
    "--signal",
    "--signal-soft",
    "--hover"
  ],
  "detectors": ["nav-link-height", "nav-destination", "header-icon-unique", "header-row-parity", "mobile-header-budget", "small-touch-target", "icon-button-scale"],
  "docs": "docs/design-system/components/nav.md"
