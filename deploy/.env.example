# Token used by docker compose (`env_file: .env`) as the coordinator admin token.
# Generate with: openssl rand -hex 32
ROTOR_COORD_TOKEN=change-me
#
# Per-client tokens are not environment variables: they live in clients.json
# (`--clients`). See deploy/README.md for the sha256sum recipe and the optional
# `--clients /data/clients.json` volume mount.
