# Token used by docker compose (`env_file: .env`) as the coordinator admin token.
# Generate with: openssl rand -hex 32
ROTOR_COORD_TOKEN=change-me
#
# Client accounts live in the state file. They are created with the admin API,
# imported once from clients.json (`--clients`), or self-registered when the
# container command also passes `--open-registration` (1/min per IP).
# See deploy/README.md for the admin endpoints and the sha256sum recipe.
