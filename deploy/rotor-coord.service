[Unit]
Description=Rotor distributed coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rotor
Group=rotor
StateDirectory=rotor
EnvironmentFile=/etc/rotor/rotor-coord.env
# Add --open-registration to allow public signup (one registration per IP per minute).
ExecStart=/opt/rotor/rotor-coord --bind 127.0.0.1:7878 --state /var/lib/rotor/coordinator.json --clients /etc/rotor/clients.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rotor

[Install]
WantedBy=multi-user.target
