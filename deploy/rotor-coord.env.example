# Admin token used to create/list jobs and read the dashboard.
# Generate with: openssl rand -hex 32
ROTOR_COORD_TOKEN=change-me

# Optional: Reown/WalletConnect project id (https://cloud.reown.com) for the
# cabinet QR login. Empty disables the WalletConnect card.
ROTOR_WALLETCONNECT_PROJECT_ID=

# Optional: TronScan Pro API key (https://tronscan.org) for the public
# /api/v1/chain/tron/address lookup. Empty disables the endpoint (501).
TRONSCAN_API_KEY=
