# Admin token used to create/list jobs and read the dashboard.
# Generate with: openssl rand -hex 32
ROTOR_COORD_TOKEN=change-me

# Operator login for the /cabinet/admin page. Set both and sign in with the
# user and password instead of pasting the token; the token above still works
# for scripts and API clients. The user defaults to "owner" when only the
# password is set.
ROTOR_ADMIN_USER=owner
ROTOR_ADMIN_PASSWORD=

# Optional: Reown/WalletConnect project id (https://cloud.reown.com) for the
# cabinet QR login. Empty disables the WalletConnect card.
ROTOR_WALLETCONNECT_PROJECT_ID=

# Optional: TronScan Pro API key (https://tronscan.org) for the public
# /api/v1/chain/tron/address lookup. Empty disables the endpoint (501).
TRONSCAN_API_KEY=

# Optional: processor-free paid downloads. ORDERS_CONFIG is the path to a JSON
# file based on deploy/orders.example.json; ORDERS_HMAC_SECRET signs delivery
# links and must be at least 32 random bytes (openssl rand -hex 32). Without
# ORDERS_CONFIG every /api/v1/orders* route answers 503.
# ORDERS_CONFIG=/etc/rotor/orders.json
# ORDERS_HMAC_SECRET=
