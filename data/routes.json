{
  "version": 1,
  "scope": "One entry per route family, not per concrete URL. Static assets (js, css, wasm, svg, fonts, images, licence text) are embedded files served by static_asset() and are deliberately not enumerated here; the gate ignores asset literals. The coordinator route table in src/coordinator/mod.rs must be a subset of these patterns.",
  "status_meaning": {
    "live": "Served today and staying on this renderer after the frontend-platform cutover.",
    "planned": "Served today (or named in openspec/changes/frontend-platform) but scheduled to move to another renderer; notes name the target phase.",
    "legacy": "Redirect or compatibility shim kept only for old links."
  },
  "auth_meaning": "public = anonymous. admin = requires the operator session (admin pages/API) or the coordinator client credential; notes name the credential class.",
  "renderers": ["astro-static", "worker-inject", "coordinator", "client-only", "api"],
