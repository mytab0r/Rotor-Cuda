# UI evidence lives in CI artifacts, never in the repo: the `ui-audit` workflow
# uploads it and the PR links the artifact. scripts/check-screenshots.mjs
# rejects tracked images under docs/ and image files under web/tests/ outside
# web/tests/__screenshots__/ (the Playwright baselines, which are test fixtures).
web/playwright-report/
web/test-results/
web/test-results-coord/
docs/**/screenshots/
docs/**/evidence/**/*.png
docs/**/evidence/**/*.jpg
docs/**/evidence/**/*.jpeg
docs/**/evidence/**/*.webp
docs/**/evidence/**/*.gif

