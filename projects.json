{
  "areas": [
    {
      "id": "site",
      "title": "Browser site and wasm client UI",
      "owner": "site-ui",
      "paths": [
        "apps/site/**",
        "data/**",
        "design/**"
      ],
      "build": [
        "node --check apps/site/site.js",
        "node --check apps/site/chains.generated.js",
        "node --check apps/site/assets.generated.js",
        "node --check apps/site/wallet-assets.js",
        "node --check apps/site/amount.js",
        "node --check apps/site/key.js",
        "node --check apps/site/address-codecs.js",
        "node --check apps/site/rotor-worker.js",
        "node --check apps/site/browse.js",
        "node --check apps/site/balance-cache.js",
        "node --check apps/site/balance-providers.js",
        "node --check apps/site/search.js",
        "node --check apps/site/theme.js",
        "node --check apps/site/vanity.js",
        "node --check apps/site/vanity-worker.js",
        "node --check apps/site/seed-page.js",
        "node --check apps/site/seed-crypto.js",
        "node --check apps/site/puzzle-browser.js",
        "node --check apps/site/puzzle-worker.js",
        "node --check apps/site/mnemonic-seeds.js",
        "node --check apps/site/key-tools.js",
        "node --check apps/site/hex-dec-bin.js",
        "node --check apps/site/public-key.js",
        "node --check apps/site/pubkey-add.js",
        "node --check apps/site/keystore-parser.js",
        "node --check apps/site/reconstruction.js",
        "node --check apps/site/brainwallet.js",
        "node --check apps/site/brainwallet-engine.js",
        "node --check apps/site/brainwallet-directory.js",
        "node --check apps/site/wallet.js",
        "node --check apps/site/wallet-summary.js",
        "node --check apps/site/wallet-vault.js",
        "node --check apps/site/wallet-sign.js",
        "node --check apps/site/wallet-evm.js",
        "node --check apps/site/wallet-btc.js",
        "node --check apps/site/wallet-history.js",
        "node --check apps/site/monitor.js",
        "node --check apps/site/wc-links.js",
        "node --check apps/site/milk-sad-scan.js",
        "node --check apps/site/wallet-security.js",
        "node --check apps/site/send.js",
        "node --check apps/site/tx-decoders.js",
        "node --check apps/site/tx-page.js",
        "node --check apps/site/site-map-admin.js",
        "node --check apps/site/analytics-admin.js",
        "node --check scripts/ui-audit.mjs",
        "node --check scripts/check-token-usage.mjs",
        "node --check scripts/build-gallery.mjs",
        "node --check scripts/check-components.mjs",
        "node --check scripts/gen-ssot.mjs",
        "node --check scripts/generated-regions.mjs",
        "node --check scripts/check-ssot.mjs",
        "node --check scripts/lib/site-routes.mjs",
        "node --check scripts/site-routes.test.mjs",
        "node --check scripts/lib/detectors.mjs",
        "node --check scripts/gen-detector-docs.mjs",
        "node scripts/gen-ssot.mjs --check",
        "node scripts/check-ssot.mjs",
        "node scripts/gen-detector-docs.mjs --check",
        "node scripts/build-tokens.mjs --check",
        "node scripts/check-token-usage.mjs",
        "node scripts/build-gallery.mjs --check",
        "node scripts/check-components.mjs"
      ],
      "test": [
        "node scripts/ui-audit.mjs --help",
        "node --test scripts/build-tokens.test.mjs",
        "node --test scripts/check-token-usage.test.mjs",
        "node --test scripts/vendor-lock.test.mjs",
        "node apps/site/amount-test.mjs",
        "node apps/site/worker-test.mjs apps/site/rotor_wasm.wasm",
        "node apps/site/puzzle-worker-test.mjs apps/site/rotor_wasm.wasm",
        "node apps/site/key-tools-test.mjs apps/site/rotor_wasm.wasm",
        "node apps/site/keystore-parser-test.mjs",
        "node apps/site/address-codecs-test.mjs",
        "node apps/site/seed-test.mjs apps/site/rotor_wasm.wasm",
        "node apps/site/mnemonic-seeds-test.mjs",
        "node apps/site/balance-cache-test.mjs",
        "node apps/site/brainwallet-test.mjs apps/site/rotor_wasm.wasm",
        "node apps/site/wallet-vault-test.mjs",
        "node apps/site/wallet-sign-test.mjs",
        "node apps/site/wallet-evm-test.mjs",
        "node apps/site/wallet-mainnet-test.mjs",
        "node apps/site/wallet-erc20-test.mjs",
        "node apps/site/wallet-approvals-test.mjs",
        "node apps/site/wallet-btc-test.mjs",
        "node apps/site/wallet-history-test.mjs",
        "node apps/site/wallet-summary-test.mjs",
        "node apps/site/wallet-assets-test.mjs",
        "node apps/site/wallet-onboarding-test.mjs",
        "node apps/site/milk-sad-scan-test.mjs",
        "node apps/site/wallet-security-test.mjs",
        "node apps/site/wallet-seed-test.mjs",
        "node apps/site/send-test.mjs",
        "node apps/site/tx-test.mjs",
        "node apps/site/search-test.mjs apps/site/rotor_wasm.wasm",
        "node apps/site/vanity-test.mjs",
        "node apps/site/qr-test.mjs",
        "node apps/site/site-nav-test.mjs",
        "node apps/site/wc-links-test.mjs",
        "node apps/site/chains-test.mjs"
      ],
      "consumes": [
        "wasm-core"
      ],
      "contracts": [
        "coordinator-embeds-web-assets-at-compile-time",
        "assets-revalidate-by-etag-html-no-store",
        "served-routes-are-fixed",
        "apps/site/rotor_wasm.wasm-is-rebuilt-by-wasm-core"
      ]
    },
    {
      "id": "web",
      "title": "Astro frontend (phase 0-1 pilot)",
      "owner": "site-ui",
      "paths": [
        "web/**"
      ],
      "build": [
        "npm --prefix web ci && npm --prefix web run build"
      ],
      "test": [
        "npm --prefix web test",
        "npm --prefix web run test:e2e"
      ],
      "consumes": [
        "wasm-core"
      ],
      "contracts": [
        "web-assets-are-locked-by-data/vendor.lock.json",
        "web-loads-vendored-seed.js-and-seed-crypto.js-unchanged",
        "web-output-is-a-static-astro-build-for-migrated-routes-only"
      ]
    },
    {
      "id": "coordinator",
      "title": "Coordinator HTTP server, API, accounts and state",
      "owner": "coordinator",
      "paths": [
        "src/coordinator/**",
        "src/bin/rotor-coord.rs",
        "tests/coordinator_api.rs",
        "tests/coordinator_client.rs"
      ],
      "build": [
        "cargo build --release --bin rotor-coord"
      ],
      "test": [
        "cargo test --test coordinator_api --test coordinator_client"
      ],
      "consumes": [
        "site",
        "wasm-core"
      ],
      "contracts": [
        "embeds-web-assets-via-include_str-include_bytes",
        "api-v1",
        "state-schema",
        "served-routes"
      ]
    },
    {
      "id": "wasm-core",
      "title": "Browser wasm core",
      "owner": "wasm-core",
      "paths": [
        "crates/rotor-wasm/**"
      ],
      "build": [
        "cargo build -p rotor-wasm --target wasm32-unknown-unknown --release",
        "sh scripts/build-wasm.sh"
      ],
      "test": [
        "cargo test -p rotor-wasm",
        "node crates/rotor-wasm/smoke.mjs target/wasm32-unknown-unknown/release/rotor_wasm.wasm",
        "node apps/site/worker-test.mjs target/wasm32-unknown-unknown/release/rotor_wasm.wasm"
      ],
      "consumes": [],
      "contracts": [
        "wasm-exports-consumed-by-apps/site/key.js-and-apps/site/rotor-worker.js",
        "committed-artifact-apps/site/rotor_wasm.wasm-must-be-fresh"
      ]
    },
    {
      "id": "desktop",
      "title": "Native CLI, search engine, GPU/BSGS and CUDA sources",
      "owner": "desktop-tools",
      "paths": [
        "src/**",
        "tests/**",
        "Rotor-Cuda/**",
        "BinSort/**",
        "Others/**",
        "Release/**",
        "build.rs",
        "Cargo.toml"
      ],
      "build": [
        "cargo build --release",
        "cargo build --release --features gpu"
      ],
      "test": [
        "cargo test --release",
        "cargo test --release --features gpu"
      ],
      "consumes": [],
      "contracts": [
        "build.rs-compiles-Rotor-Cuda-GPU-sources",
        "no-silent-cpu-fallback-in-gpu-mode",
        "shared-lib-src/lib.rs-consumed-by-coordinator-and-wasm",
        "BinSort-Others-Release-are-archival-no-new-code"
      ]
    },
    {
      "id": "ops",
      "title": "CI, deploy, scripts, specs and docs",
      "owner": "ops/docs",
      "paths": [
        ".github/**",
        ".claude/skills/**",
        ".impeccable/**",
        "deploy/**",
        "scripts/**",
        "openspec/**",
        "docs/**",
        "Dockerfile",
        "README.md",
        "LICENSE",
        ".gitignore",
        "AGENTS.md",
        "PROJECTS.md",
        "projects.json",
        "SECURITY.md",
        "PRODUCT.md",
        "CHANGELOG.md",
        "release-please-config.json",
        ".release-please-manifest.json"
      ],
      "build": [
        "node --check docs/site-map/site-map.js",
        "node --check docs/site-map/site-map-data.js",
        "node --check docs/site-map/theme.js",
        "node --check scripts/sync-board.mjs",
        "node --check scripts/check-task-links.mjs",
        "node --check scripts/check-process.mjs",
        "node --check scripts/mutate-changed.mjs",
        "node --check scripts/lib/task-tracking.mjs",
        "node --check scripts/density-parity.mjs",
        "node --check scripts/check-screenshots.mjs",
        "node --check scripts/check-seo.mjs",
        "node --check scripts/check-advisories.mjs",
        "node --check scripts/gen-security-page.mjs",
        "node --check scripts/lib/security-advisories.mjs",
        "node --check deploy/cloudflare/provider-proxy/src/worker.mjs",
        "node --check deploy/cloudflare/provider-proxy/src/upstreams.mjs",
        "node --check scripts/security-audit.mjs",
        "node scripts/check-projects.mjs"
      ],
      "test": [
        "node --test deploy/cloudflare/test/worker.test.mjs",
        "node --test deploy/cloudflare/provider-proxy/test/provider-proxy.test.mjs",
        "node docs/site-map/site-map-test.mjs",
        "node scripts/density-parity.mjs --help",
        "node --test scripts/task-tracking.test.mjs",
        "node --test scripts/check-task-links.test.mjs",
        "node --test scripts/check-process.test.mjs",
        "node --test scripts/mutate-changed.test.mjs",
        "node --test scripts/check-advisories.test.mjs",
        "node --test scripts/site-routes.test.mjs",
        "node scripts/check-advisories.mjs",
        "node scripts/gen-security-page.mjs --check",
        "node scripts/check-projects.mjs",
        "node scripts/check-screenshots.mjs",
        "node scripts/security-audit.mjs --help",
        "node --test scripts/security-audit.test.mjs"
      ],
      "consumes": [],
      "contracts": [
        "ci-path-filters-cover-all-areas",
        "docker-rebuilds-apps/site/rotor_wasm.wasm",
        "deploy-secrets-by-name-only",
        "new-root-files-must-join-an-area"
      ]
    }
  ]
}
